{
  "name": "souvenirshop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "styles:bootstrap": "node scripts/scope-bootstrap.mjs",
    "predev": "npm run styles:bootstrap",
    "prebuild": "npm run styles:bootstrap",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "preview": "vite preview",
    "pretest:e2e": "npm run styles:bootstrap && npm --prefix ../backend run build",
    "test:e2e": "node test/e2e/fullStack.cjs",
    "pretest:e2e:commercial": "npm run pretest:e2e",
    "test:e2e:commercial": "node test/e2e/fullStack.cjs --commercial-fixes",
    "pretest:e2e:completion": "npm run pretest:e2e",
    "test:e2e:completion": "node test/e2e/fullStack.cjs --completion",
    "pretest:e2e:routes": "npm run pretest:e2e",
    "test:e2e:routes": "node test/e2e/fullStack.cjs --routes",
    "pretest:e2e:usability": "npm run pretest:e2e",
    "test:e2e:usability": "node test/e2e/fullStack.cjs --usability",
    "pretest:ui": "npm run styles:bootstrap",
    "test:ui": "node test/e2e/frontend-states.cjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.18.1",
    "bootstrap": "^5.3.8",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "1.62.1",
    "postcss": "^8.5.31",
    "vite": "^8.1.6"
  }
}
