{
  "name": "souvenirshop-backend",
  "version": "1.0.0",
  "description": "SouvenirShop NestJS API with PostgreSQL and Sequelize",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "env:local": "node src/scripts/initLocalEnv.js",
    "db:check": "node src/database/check.js",
    "docs:api": "node scripts/build-api-docs.cjs",
    "docs:stories": "node scripts/build-story-matrix.cjs",
    "verify:db": "node src/scripts/verifyLocalDatabase.js",
    "migrate": "node src/database/migrate.js",
    "seed": "npm run seed:demo",
    "seed:demo": "node src/database/seed.js",
    "seed:culture": "node src/database/seedCulture.js",
    "smoke:vietqr": "node src/scripts/smokeVietqrCheckout.js",
    "smoke:core": "node src/scripts/smokeCoreFlows.js",
    "smoke:culture": "node src/scripts/smokeCulture.js",
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prestart": "npm run build",
    "test": "npm run build && node --test test/*.test.cjs",
    "preverify:db": "npm run build",
    "presmoke:core": "npm run build",
    "presmoke:vietqr": "npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.14",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sequelize": "^6.35.2"
  },
  "devDependencies": {
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
