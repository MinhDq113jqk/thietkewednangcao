# Cau hinh demo nop bai; co the dua tep nay len GitHub.
# Thong tin rieng dat trong backend/.env.local (khong dua len Git).
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/souvenirshop
# Khoa JWT minh hoa cong khai, chi dung cho demo mon hoc tren may.
JWT_SECRET=souvenirshop_demo_access_public_2026_only
JWT_REFRESH_SECRET=souvenirshop_demo_refresh_public_2026_only
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_MAX_AGE_SECONDS=604800
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
PORT=3000
CLIENT_URL=http://localhost:5173

# Local seed/smoke accounts. Keep real credentials in backend/.env.local only.
SEED_ACCOUNT_PASSWORD=SouvenirShop-Demo-2026!
SMOKE_BUYER_EMAIL=buyer-test@example.com
SMOKE_BUYER_PASSWORD=SouvenirShop-Demo-2026!

# VietQR.io
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
BANK_ACQ_ID=970422

# Bank-transfer reservation lifetime; expiry worker checks every 15 seconds.
PAYMENT_WINDOW_MINUTES=30
PAYMENT_EXPIRY_WORKER_ENABLED=true
RETURN_WINDOW_DAYS=7

# SMTP email
NOTIFICATION_WORKER_ENABLED=true
# CLIENT_URL is the trusted frontend origin used for recovery/verification links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SouvenirShop <no-reply@example.com>

# Upload provider: local or cloudinary. If omitted, backend uses Cloudinary only
# when all Cloudinary credentials are present; otherwise it falls back to local.
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=souvenirshop

# Production CORS: comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
