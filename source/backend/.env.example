NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/souvenirshop
JWT_SECRET=generate_a_unique_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=generate_a_different_random_refresh_secret_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_MAX_AGE_SECONDS=604800
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
PORT=3000
CLIENT_URL=http://localhost:5173

# Local seed/smoke accounts. Keep real credentials in backend/.env only.
SEED_ACCOUNT_PASSWORD=set_a_local_seed_password
SMOKE_BUYER_EMAIL=buyer-test@example.com
SMOKE_BUYER_PASSWORD=set_the_same_local_seed_password

# VietQR.io
VIETQR_CLIENT_ID=your_client_id
VIETQR_API_KEY=your_api_key
BANK_ACCOUNT_NO=your_bank_account_no
BANK_ACCOUNT_NAME=TEN_CHU_TAI_KHOAN_KHONG_DAU
BANK_ACQ_ID=970422

# SMTP email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=SouvenirShop <no-reply@example.com>

# Upload provider: local or cloudinary. If omitted, backend uses Cloudinary only
# when all Cloudinary credentials are present; otherwise it falls back to local.
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=souvenirshop

# Production CORS: comma-separated allowed frontend origins.
CORS_ORIGINS=https://your-frontend.example.com
