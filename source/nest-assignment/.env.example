PORT=3100
NODE_ENV=development

# Local PostgreSQL database created for this assignment.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nest_assignment
DATABASE_SSL=false
TYPEORM_SYNCHRONIZE=true

# Replace both values locally. Never commit .env or show it in screenshots.
JWT_SECRET=replace-with-a-long-random-jwt-secret
SESSION_SECRET=replace-with-a-long-random-session-secret
